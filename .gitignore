# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
var/
wheels/
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
backend/venv/
backend/env/

# Local databases & caches
*.db
*.sqlite
*.sqlite3

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing and coverage
.coverage
htmlcov/
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/

# Local data & uploads (preserve directory structure via .gitkeep)
data/documents/*
!data/documents/.gitkeep
data/schedules/*
!data/schedules/.gitkeep
data/procurement/*
!data/procurement/.gitkeep
data/sample/*
!data/sample/.gitkeep
uploads/
storage/

# Secrets and Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=epc_user
POSTGRES_PASSWORD=epc_secure_password
POSTGRES_DB=datacentre_epc
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://epc_user:epc_secure_password@localhost:5432/datacentre_epc

# AI & LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Embedding Configuration
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# File Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=50

# Vector Store Configuration
VECTOR_STORE_BACKEND=pgvector
VECTOR_COLLECTION_NAME=epc_document_chunks
